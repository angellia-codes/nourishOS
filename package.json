{
  "name": "nourishos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "tsc && vite build",
    "check": "node functions/test/invariants.mjs",
    "test": "npm --prefix functions run build && node --test \"functions/test/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nourishos \"node --test functions/test/rules.mjs\"",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "dev:portal": "vite --config vite.portal.config.ts",
    "build:portal": "tsc -p portal/tsconfig.json && vite build --config vite.portal.config.ts",
    "dev:portal:emulator": "vite --config vite.portal.config.ts --mode emulator"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^11.0.0",
    "firebase-functions": "^4.9.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
