# Copy to .env.local for local development (never commit .env.local).
# Use a separate Firebase project per environment per ROADMAP.md Phase 0
# (nourishos-dev / nourishos-staging / nourishos-prod).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to connect to local Firebase Emulator Suite instead of live project
VITE_USE_FIREBASE_EMULATOR=false

# App Check site key (Google Cloud Fraud Defense, formerly reCAPTCHA
# Enterprise) — required for the public-facing portal/ and welcome/ apps, which
# are unauthenticated and otherwise have no abuse control beyond a
# duplicate-submission check. Create it in Google Cloud Console > Security >
# Fraud Defense > Create key: type Web, score-based (Challenge = No), domains =
# every host the apps are served from. Use its Key ID here, and register the
# same key under Firebase Console > App Check > Apps > Fraud Defense.
# Leave blank in dev — App Check falls back to a debug token there instead.
# The internal SPA (src/) does not need this; only portal/ and welcome/ read it.
VITE_RECAPTCHA_SITE_KEY=
