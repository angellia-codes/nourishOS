# Copy to .env.local for local development (never commit .env.local).
# Use a separate Firebase project per environment per ROADMAP.md Phase 0
# (nourishos-dev / nourishos-staging / nourishos-prod).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to connect to local Firebase Emulator Suite instead of live project
VITE_USE_FIREBASE_EMULATOR=false

# App Check (reCAPTCHA v3) site key — required for the public-facing portal/
# and welcome/ apps, which are unauthenticated and otherwise have no abuse
# control beyond a duplicate-submission check. Get one at
# https://www.google.com/recaptcha/admin (type "v3"), registered for every
# domain the apps are served from (prod, Vercel preview domains, localhost).
# Leave blank in dev — App Check falls back to a debug token there instead.
# The internal SPA (src/) does not need this; only portal/ and welcome/ read it.
VITE_RECAPTCHA_SITE_KEY=
